---
import "@fontsource/mochiy-pop-one";

import Link from "./Link.astro";
import Icon from "../../public/icon.webp";

import { fetchContributionStats, fetchLanguageStats, getLanguageColor } from "../lib/github";
import { GITHUB_USERNAME, PROFILE } from "../consts";
import { Image } from "astro:assets";

export type Props = {
  shortInMobile?: boolean;
};

const shortInMobile = Astro.props.shortInMobile ?? true;
const contributionStats = await fetchContributionStats(GITHUB_USERNAME);
const languageStats = await fetchLanguageStats(GITHUB_USERNAME);

const githubProfileUrl = `https://github.com/${GITHUB_USERNAME}`;

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const now = new Date();
const oneYearAgo = new Date(now);
oneYearAgo.setUTCFullYear(now.getUTCFullYear() - 1);
const pastYearUrl = `${githubProfileUrl}?tab=overview&from=${formatDate(oneYearAgo)}&to=${formatDate(now)}`;
---

<div class="profile-txts">
  <div>
    <Image class="profile-icon" src={Icon} alt="" />
  </div>
  <div>
    <p class="profile-name">{PROFILE.name}</p>
    <p class="profile-description">{PROFILE.description}</p>
  </div>
</div>
{
  contributionStats && (
    <div class="github-stats">
      <a class="github-stat" href={githubProfileUrl} target="_blank" rel="noopener noreferrer">
        <p class="github-stat-value">{contributionStats.totalContributions.toLocaleString()}</p>
        <p class="github-stat-label">Total Contributions</p>
      </a>
      <a class="github-stat" href={pastYearUrl} target="_blank" rel="noopener noreferrer">
        <p class="github-stat-value">{contributionStats.lastYearContributions.toLocaleString()}</p>
        <p class="github-stat-label">Past Year</p>
      </a>
    </div>
  )
}
{
  languageStats && languageStats.length > 0 && (
    <div class="language-stats">
      <p class="sub-head-label">使用言語</p>
      <div class="language-bar">
        {languageStats.map((lang) => (
          <span
            class="language-bar-segment"
            style={`width: ${lang.percentage}%; background-color: ${getLanguageColor(lang.name)};`}
            title={`${lang.name} ${lang.percentage.toFixed(1)}%`}
          />
        ))}
      </div>
      <ul class="language-legend">
        {languageStats.map((lang) => (
          <li>
            <span
              class="language-dot"
              style={`background-color: ${getLanguageColor(lang.name)};`}
            />
            <span>{lang.name}</span>
            <span class="language-percentage">{lang.percentage.toFixed(1)}%</span>
          </li>
        ))}
      </ul>
    </div>
  )
}
<div class={shortInMobile ? "profile-info" : ""}>
  <div>
    <div class="sub-head">
      <p>所属</p>
    </div>
    <div class="profile-link">
      {PROFILE.orgs.map((props) => <Link {...props} />)}
    </div>
  </div>
  <div>
    <div class="sub-head">
      <p>開発参加</p>
    </div>
    <div class="profile-link">
      {PROFILE.coding.map((props) => <Link {...props} />)}
    </div>
  </div>
  <div>
    <div class="sub-head">
      <p>関連リンク</p>
    </div>
    <div class="profile-link">
      {PROFILE.links.map((props) => <Link {...props} />)}
    </div>
  </div>
</div>
<div class={`sub-head ${shortInMobile ? "about-link" : "hidden"}`}>
  <p>
    <a href={`${import.meta.env.BASE_URL}about`}>詳細を閲覧</a>
  </p>
</div>

<style>
  .profile-icon {
    border-radius: 50%;
    width: 50%;
    margin: 0 auto;
  }
  .profile-name {
    font-size: 30px;
    font-weight: 600;
    text-align: center;
  }
  .profile-description {
    text-align: center;
  }
  .github-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 80%;
    margin: 14px auto 0;
  }
  .github-stat {
    display: block;
    border-radius: 15px;
    background-color: #f5f5f5;
    padding: 8px 4px;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .github-stat:hover {
    background-color: #ececec;
  }
  .github-stat-value {
    font-size: 20px;
    font-weight: 600;
    color: black;
  }
  .github-stat-label {
    font-size: 11px;
    color: gray;
  }
  .language-stats {
    width: 80%;
    margin: 14px auto 0;
  }
  .sub-head-label {
    text-align: center;
    font-family: "Mochiy Pop One", sans-serif;
    font-size: 14px;
    margin-bottom: 8px;
  }
  .language-bar {
    display: flex;
    overflow: hidden;
    width: 100%;
    height: 10px;
    border-radius: 6px;
    background-color: #f5f5f5;
  }
  .language-bar-segment {
    height: 100%;
  }
  .language-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    margin-top: 10px;
    padding: 0;
  }
  .language-legend li {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    font-size: 12px;
    color: black;
  }
  .language-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .language-percentage {
    color: gray;
  }
  .profile-link {
    width: 80%;
    margin: 0 auto 26px;
  }
  .sub-head {
    text-align: center;
    margin-top: 10px;
  }
  .sub-head p {
    font-family: "Mochiy Pop One", sans-serif;
    font-size: 18px;
  }
  .about-link {
    display: none;
  }

  @media screen and (max-width: 950px) {
    .profile-icon {
      width: 30%;
    }
  }
  @media screen and (max-width: 950px) {
    .profile-info {
      display: none;
    }
    .about-link {
      display: block !important;
      margin-top: 30px !important;
    }
  }
</style>

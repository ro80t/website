---
import ContentsBlock from "../components/ContentsBlock.astro";
import MarkDown from "../components/MarkDown.astro";
import Profile from "../components/Profile.astro";
import ProjectCard from "../components/ProjectCard.astro";
import MainLayout from "../layouts/MainLayout.astro";

import {
  fetchAccountStats,
  fetchContributionStats,
  fetchRepoStats,
  getGithubProfileUrl,
  getLanguageColor,
  getPastYearContributionUrl
} from "../lib/github";
import { GITHUB_USERNAME, PORTFOLIO_PROJECTS } from "../consts";
import { getEntry, render } from "astro:content";

const portfolio = await getEntry("specs", "portfolio");

if (!portfolio) {
  throw new Error("specs/portfolio.mdx was not found");
}

const { Content } = await render(portfolio);

const accountStats = await fetchAccountStats(GITHUB_USERNAME);
const contributionStats = await fetchContributionStats(GITHUB_USERNAME);
const languageStats = accountStats?.languageStats ?? null;

const githubProfileUrl = getGithubProfileUrl(GITHUB_USERNAME);
const pastYearUrl = getPastYearContributionUrl(GITHUB_USERNAME);

const projects = await Promise.all(
  PORTFOLIO_PROJECTS.map(async ({ owner, repo }) => {
    const stats = await fetchRepoStats(owner, repo, GITHUB_USERNAME);
    return {
      title: repo,
      description: stats.description ?? "",
      url: stats.url,
      repository: stats.url,
      totalCommitCount: stats.totalCommitCount,
      authorCommitCount: stats.authorCommitCount,
      tags: stats.language ? [stats.language] : []
    };
  })
);
---

<MainLayout title="Portfolio">
  <div class="layout" data-pagefind-ignore>
    <div class="right">
      <div class="profile">
        <ContentsBlock>
          <Profile shortInMobile={false} />
        </ContentsBlock>
      </div>
    </div>
    <div class="left">
      <ContentsBlock>
        <MarkDown>
          <Content />
          {
            (contributionStats || accountStats) && (
              <>
                <h2>GitHub Stats</h2>
                <div class="not-prose github-stats">
                  {contributionStats && (
                    <div class="contribution-stats">
                      <a
                        class="contribution-stat"
                        href={githubProfileUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <p class="contribution-stat-value">
                          {contributionStats.totalContributions.toLocaleString()}
                        </p>
                        <p class="contribution-stat-label">Total Contributions</p>
                      </a>
                      <a
                        class="contribution-stat"
                        href={pastYearUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <p class="contribution-stat-value">
                          {contributionStats.lastYearContributions.toLocaleString()}
                        </p>
                        <p class="contribution-stat-label">Past Year</p>
                      </a>
                    </div>
                  )}
                  {accountStats && (
                    <div class="github-stats-grid">
                      <div class="stat-box">
                        <p class="stat-value">{accountStats.totalRepos.toLocaleString()}</p>
                        <p class="stat-label">Repositories</p>
                      </div>
                      <div class="stat-box">
                        <p class="stat-value">{accountStats.followers.toLocaleString()}</p>
                        <p class="stat-label">Followers</p>
                      </div>
                      <div class="stat-box">
                        <p class="stat-value">{accountStats.following.toLocaleString()}</p>
                        <p class="stat-label">Following</p>
                      </div>
                      <div class="stat-box">
                        <p class="stat-value">{accountStats.totalStars.toLocaleString()}</p>
                        <p class="stat-label">Total Stars</p>
                      </div>
                    </div>
                  )}
                </div>
              </>
            )
          }
          {
            languageStats && languageStats.length > 0 && (
              <>
                <h2>使用言語</h2>
                <div class="not-prose language-stats">
                  <div class="language-bar">
                    {languageStats.map((lang) => (
                      <span
                        class="language-bar-segment"
                        style={`width: ${lang.percentage}%; background-color: ${getLanguageColor(lang.name)};`}
                        title={`${lang.name} ${lang.percentage.toFixed(1)}%`}
                      />
                    ))}
                  </div>
                  <ul class="language-legend">
                    {languageStats.map((lang) => (
                      <li>
                        <span
                          class="language-dot"
                          style={`background-color: ${getLanguageColor(lang.name)};`}
                        />
                        <span>{lang.name}</span>
                        <span class="language-percentage">{lang.percentage.toFixed(1)}%</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )
          }
          <h2>Projects</h2>
          <div class="not-prose projects">
            {projects.map((project) => <ProjectCard {...project} />)}
          </div>
        </MarkDown>
      </ContentsBlock>
    </div>
  </div>
</MainLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 50% 50%;
  }
  .profile {
    overflow: hidden;
    width: 100%;
    margin: 0;
  }
  .github-stats {
    margin-top: 4px;
  }
  .contribution-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .contribution-stat {
    display: block;
    border-radius: 15px;
    background-color: #f5f5f5;
    padding: 16px 4px;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .contribution-stat:hover {
    background-color: #ececec;
  }
  .contribution-stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #2563eb;
  }
  .contribution-stat-label {
    font-size: 12px;
    color: gray;
  }
  .github-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }
  .stat-box {
    border-radius: 15px;
    background-color: #f5f5f5;
    padding: 10px 4px;
    text-align: center;
  }
  .stat-value {
    font-size: 22px;
    font-weight: 700;
    color: black;
  }
  .stat-label {
    font-size: 11px;
    color: gray;
  }
  .language-stats {
    margin-top: 4px;
  }
  .language-bar {
    display: flex;
    overflow: hidden;
    width: 100%;
    height: 10px;
    border-radius: 6px;
    background-color: #f5f5f5;
  }
  .language-bar-segment {
    height: 100%;
  }
  .language-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 10px;
    padding: 0;
  }
  .language-legend li {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    font-size: 13px;
    color: black;
  }
  .language-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .language-percentage {
    color: gray;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  p {
    color: black;
  }

  @media screen and (max-width: 950px) {
    .layout {
      grid-template-columns: 100%;
    }
  }

  @media screen and (max-width: 500px) {
    .github-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
